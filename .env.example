# Copy to .env (docker compose reads it) and change the secrets before deploying anywhere real.
FOODWISE_ENV=development            # production refuses demo accounts and dev secrets
FOODWISE_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
FOODWISE_LINK_SECRET=dev-only-link-secret-change-me-0123456789
FOODWISE_PUBLIC_BASE_URL=http://localhost:8080
# FOODWISE_DB_PORT=5433
# FOODWISE_PLACES_PROVIDER=overpass   # or none
# FOODWISE_IMAGES_PROVIDER=wikimedia  # or none
# FOODWISE_CONTACT=you@example.com    # sent to OpenStreetMap and Wikimedia in the User-Agent, as they ask
